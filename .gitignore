# Ignore uploaded media files
uploads/*

# Ignore logs folder
logs/*

# Ignore database
database.db*

# Ignore runtime game state
game_state.json

# Ignore auth and SMTP secrets
auth_config.json
smtp_config.json

# Ignore .claude folder
.claude/*

# Ignore postman files
postman/*
.postman/*
# Ignore Python bytecode and test cache
__pycache__/
*.pyc
.pytest_cache/

# Ignore saved game configs (questions/answers)
saved_configs.json

# Ignore JSON backups / temp files from atomic writes
*.bak
*.tmp
